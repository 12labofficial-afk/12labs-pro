# Copy this file to functions/.env and fill in real values.
# Firebase Functions (2nd gen) loads functions/.env at deploy time.

# Your website (no trailing slash). The function only calls
#   {SITE_URL}/api/cron/subscription-grants   once an hour.
SITE_URL=https://www.12labs.in

# Must be the SAME value as CRON_SECRET in the website's environment (Vercel).
# The website rejects the call without it.
CRON_SECRET=
